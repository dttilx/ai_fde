# Copy to .env and replace placeholders; scripts/setup_local.ps1 creates random local secrets.
POSTGRES_ADMIN_PASSWORD=replace-with-random-local-secret
POSTGRES_RUNTIME_PASSWORD=replace-with-another-random-secret
MINIO_ROOT_USER=apx_storage_admin
MINIO_ROOT_PASSWORD=replace-with-random-local-secret
MINIO_APP_USER=apx_media_service
MINIO_APP_PASSWORD=replace-with-another-random-secret
DATABASE_URL=postgresql+psycopg://apx_runtime:replace-with-another-random-secret@127.0.0.1:55432/apx240
MIGRATION_DATABASE_URL=postgresql+psycopg://apx_admin:replace-with-random-local-secret@127.0.0.1:55432/apx240
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_BUCKET=apx240-media
PROVIDER_MODE=FIXTURE
OCR_PROVIDER=rapidocr
JEV_API_KEY=
# Required only for an explicitly approved real Jev run; keep the key server-side.
JEV_MODEL=jev-1.13.0
JEV_PROFILE_PATH=.private/jev-profile.json
COOKIE_SECURE=false
