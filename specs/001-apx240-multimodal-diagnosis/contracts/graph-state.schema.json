{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apx240/graph-state/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_run_id",
    "graph_thread_id",
    "state",
    "checkpoint_version",
    "resume_count",
    "interrupt_id",
    "interrupt_type",
    "pending_questions",
    "question_details",
    "pending_expert_action",
    "active_job_id",
    "counters",
    "failure_reason"
  ],
  "properties": {
    "diagnosis_run_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PREPARING",
        "SAFETY_CHECK",
        "RETRIEVING",
        "NEEDS_INFORMATION",
        "WAITING_EXPERT",
        "CONFLICT_BLOCKED",
        "FINALIZING",
        "COMPLETED",
        "ESCALATED",
        "FAILED"
      ]
    },
    "checkpoint_version": {
      "type": "integer",
      "minimum": 0
    },
    "resume_count": {
      "type": "integer",
      "minimum": 0
    },
    "interrupt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "interrupt_type": {
      "enum": [
        "INFORMATION",
        "EXPERT",
        "HIGH_RISK",
        "REPORT_REVIEW",
        null
      ]
    },
    "pending_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "question_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "text", "blocking", "reason", "citation_ids", "source_ref", "locator"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "citation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "locator": {"type": "object"}
        }
      }
    },    "pending_expert_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "retrieval_rounds",
        "distinct_questions",
        "tool_calls",
        "aggregate_tokens",
        "resumes",
        "active_seconds"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_questions": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "aggregate_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "resumes": {
          "type": "integer",
          "minimum": 0
        },
        "active_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "PublicGraphStatus; not the internal checkpoint"
}
